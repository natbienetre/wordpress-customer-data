{
	"name": "wordpress-customer-data",
	"version": "1.0.0",
	"description": "WordPress plugin for customer data management",
	"author": "Pierre PÉRONNET",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"plugin",
		"data",
		"openstack",
		"swift",
		"storage"
	],
	"homepage": "https://github.com/natbienetre/wordpress-customer-data",
	"repository": {
		"type": "git",
		"url": "https://github.com/natbienetre/wordpress-customer-data.git"
	},
	"bugs": {
		"url": "https://github.com/natbienetre/wordpress-customer-data/issues"
	},
	"files": [
		"build",
		"classes",
		"languages",
		"*.php",
		"vendor",
		"readme.txt"
	],
	"dependencies": {
		"@wordpress/blocks": "^14.15.0",
		"@wordpress/commands": "^1.55.0",
		"@wordpress/dataviews": "^4.22.0",
		"@wordpress/edit-post": "^8.55.0",
		"@wordpress/interactivity": "^6.55.0",
		"@wordpress/preferences": "^4.55.0",
		"content-disposition": "^0.5.4",
		"crypto-browserify": "^3.12.1",
		"jose": "^6.2.12",
		"jszip": "^3.10.2",
		"path-browserify": "^1.0.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"remove": "^0.1.5",
		"vcard-parser": "^1.0.0",
		"webpack": "5.111.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/plugin-proposal-class-properties": "^7.18.6",
		"@babel/plugin-proposal-object-rest-spread": "^7.20.7",
		"@babel/plugin-transform-class-properties": "^7.29.7",
		"@babel/plugin-transform-modules-commonjs": "^7.29.7",
		"@babel/plugin-transform-object-rest-spread": "^7.29.7",
		"@babel/plugin-transform-runtime": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"@babel/preset-react": "^7.29.7",
		"@babel/preset-typescript": "^7.29.7",
		"@jest/globals": "^29.7.0",
		"@types/content-disposition": "^0.5.9",
		"@types/jest": "^29.5.14",
		"@types/jszip": "^3.4.1",
		"@types/node": "^22.20.2",
		"@types/webpack": "^5.28.5",
		"@types/wordpress__blocks": "^12.5.18",
		"@wordpress/base-styles": "^5.23.0",
		"@wordpress/block-editor": "^14.21.0",
		"@wordpress/components": "^29.12.0",
		"@wordpress/editor": "^14.54.0",
		"@wordpress/element": "^6.46.0",
		"@wordpress/i18n": "^5.26.0",
		"@wordpress/icons": "^10.32.0",
		"@wordpress/jest-console": "^8.51.0",
		"@wordpress/jest-preset-default": "^12.51.0",
		"@wordpress/readable-js-assets-webpack-plugin": "^3.55.0",
		"@wordpress/scripts": "^30.27.0",
		"@wordpress/url": "^4.55.0",
		"babel-jest": "^29.7.0",
		"babel-loader": "^10.1.1",
		"copy-webpack-plugin": "^13.0.1",
		"css-loader": "^7.1.5",
		"grunt": "^1.6.3",
		"grunt-wp-i18n": "^1.0.4",
		"grunt-wp-readme-to-markdown": "^2.1.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"process": "^0.11.10",
		"ts-jest": "^29.4.12",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "5.9",
		"webpack-cli": "^6.0.1"
	},
	"scripts": {
		"build": "ts-node -r tsconfig-paths/register ./node_modules/.bin/wp-scripts build --blocks-manifest --config=./webpack.config.ts  --experimental-modules",
		"build:copy-php": "ts-node -r tsconfig-paths/register ./node_modules/.bin/wp-scripts build --webpack-copy-php --config=./webpack.config.ts --experimental-modules",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:css:fix": "wp-scripts lint-style --fix",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:md:docs:fix": "wp-scripts lint-md-docs --fix",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "WP_DEVTOOL=true ts-node -r tsconfig-paths/register ./node_modules/.bin/wp-scripts start --blocks-manifest --mode=development --devtool=source-map --config=./webpack.config.ts --experimental-modules",
		"start:hot": "WP_DEVTOOL=true ts-node -r tsconfig-paths/register ./node_modules/.bin/wp-scripts start --blocks-manifest --hot --mode=development --devtool=source-map --config=./webpack.config.ts --experimental-modules",
		"start:copy-php": "WP_DEVTOOL=true ts-node -r tsconfig-paths/register ./node_modules/.bin/wp-scripts start --webpack-copy-php --experimental-modules",
		"test:e2e": "wp-scripts test-e2e",
		"test:config": "webpack configtest",
		"test:unit": "wp-scripts test-unit-js",
		"test:unit:watch": "wp-scripts test-unit-js --watch"
	},
	"packageManager": "yarn@4.9.2",
	"resolutions": {
		"webpack": "5.111.0"
	}
}
